# Variables del frontend de Pilot (Vite). Copie este archivo a `.env.local` para desarrollo.
# Solo se exponen al navegador las variables con prefijo VITE_; nunca ponga secretos aquí.
# Se validan al arrancar: si falta alguna, la app muestra un error de configuración claro.

# Emisor OIDC: realm "pilot" de Keycloak (infra/keycloak/README.md)
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/pilot

# Cliente público del realm, con PKCE S256 (sin secreto)
VITE_OIDC_CLIENT_ID=pilot-web

# Base de la API REST de Pilot; el cliente antepone este valor a las rutas del contrato
VITE_API_BASE_URL=http://localhost:8080/api/v1
