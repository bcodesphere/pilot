# Variables de entorno de desarrollo local de Pilot 1.0.
# Copiar a .env y completar. El archivo .env NUNCA se commitea (regla 1.2.7 de CLAUDE.md).
# IMPORTANTE: Docker Compose toma un comentario en la misma línea como valor de una variable vacía;
# por eso cada comentario va en su propia línea, encima de la variable.

# --- PostgreSQL ---
# Contraseña de pilot_owner (dueño del esquema, solo migraciones Flyway)
PG_OWNER_PASSWORD=
# Contraseña de pilot_app (usuario de la aplicación, sin BYPASSRLS)
PG_APP_PASSWORD=

# --- Keycloak ---
# Contraseña del administrador de la consola de Keycloak
KC_ADMIN_PASSWORD=

# --- n8n ---
# Llave fija de cifrado de credenciales de n8n; respaldarla
N8N_ENCRYPTION_KEY=
# Opcional; por defecto 5678. Cámbielo si el puerto ya está ocupado
N8N_PUERTO=

# --- Pilot API ---
# Emisor de tokens (realm "pilot")
PILOT_OIDC_ISSUER=http://localhost:8180/realms/pilot
