# Variables de entorno de desarrollo local de Pilot 1.0.
# Copiar a .env y completar. El archivo .env NUNCA se commitea (regla 1.2.7 de CLAUDE.md).

# --- PostgreSQL ---
PG_OWNER_PASSWORD=          # Contraseña de pilot_owner (dueño del esquema, solo migraciones Flyway)
PG_APP_PASSWORD=            # Contraseña de pilot_app (usuario de la aplicación, sin BYPASSRLS)

# --- Keycloak ---
KC_ADMIN_PASSWORD=          # Contraseña del administrador de la consola de Keycloak

# --- n8n ---
N8N_ENCRYPTION_KEY=         # Llave fija de cifrado de credenciales de n8n; respaldarla

# --- Pilot API ---
PILOT_OIDC_ISSUER=http://localhost:8180/realms/pilot   # Emisor de tokens (realm "pilot")
